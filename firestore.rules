rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function anonymous() { return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous'; }
    function own(uid) { return anonymous() && request.auth.uid == uid; }
    function policy() { return get(/databases/$(database)/documents/study/config).data; }
    function text(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    function optionalText(v, max) { return v is string && v.size() <= max; }
    function fields(v, keys) { return v is map && v.keys().hasAll(keys) && v.keys().hasOnly(keys); }
    function food(f) {
      // String methods reject non-strings. Accessing each mandatory property also
      // rejects missing keys. Inline checks keep worst-case rules below 1,000 expressions.
      return f.name.matches('(?s).{1,200}') && f.unit.matches('(?s).{1,80}')
        && f.quantity is number && f.quantity > 0
        && (f.source == 'INDB'
          ? (f.quantity <= 100 && f.keys().hasOnly(['source','foodCode','name','unit','quantity']) && f.foodCode.matches('[A-Za-z0-9_-]{1,40}'))
          : (f.source == 'CUSTOM' && f.quantity <= {'g':10000, 'ml':10000}.get(f.unit,100) && f.keys().hasOnly(['source','foodCode','name','unit','quantity','brand','preparation']) && f.foodCode == null && f.brand.matches('(?s).{0,100}') && f.preparation.matches('(?s).{0,300}')));
    }
    function itemAt(items, i) { return items.size() <= i || food(items[i]); }
    function meal(m, version) {
      let entries = m.entries;
      return (version == 3 ? (fields(m, ['label','skipped','entries','createdAt']) && text(m.label,80)) : fields(m, ['skipped','entries','createdAt'])) && m.createdAt == request.time && m.skipped is bool && entries is list && entries.size() <= 8
        && (m.skipped ? entries.size() == 0 : entries.size() > 0)
        && itemAt(entries,0) && itemAt(entries,1) && itemAt(entries,2) && itemAt(entries,3) && itemAt(entries,4)
        && itemAt(entries,5) && itemAt(entries,6) && itemAt(entries,7);
    }
    function profile(p) {
      return fields(p, ['age','sex','heightCm','weightKg','goal','diet','avoided','otherAvoided','pattern','activity'])
        && p.age is int && p.age >= 16 && p.sex in ['male','female']
        && p.heightCm is number && p.heightCm >= 80 && p.heightCm <= 250
        && p.weightKg is number && p.weightKg >= 20 && p.weightKg <= 350
        && p.goal in ['Weight loss','Weight maintenance','Weight gain']
        && p.diet in ['Vegetarian','Eggetarian','Non-vegetarian','Vegan']
        && p.avoided is list && p.avoided.size() >= 1 && p.avoided.size() <= 8
        && p.avoided.toSet().size() == p.avoided.size()
        && p.avoided.hasOnly(['Eggs','Dairy','Wheat/gluten','Peanuts','Tree nuts','Seafood','Other','None'])
        && (!p.avoided.hasAny(['None']) || p.avoided.size() == 1)
        && (p.avoided.hasAny(['Other']) ? text(p.otherAvoided,200) : p.otherAvoided == '')
        && p.pattern in ['','2 meals per day','3 meals per day','4 meals per day','5 or more meals per day','Varies']
        && p.activity in ['','Sedentary','Lightly active','Moderately active','Very active','Prefer not to answer'];
    }
    function minorApproved(uid, c, cfg) {
      let grant = get(/databases/$(database)/documents/minorEligibility/$(uid)).data;
      return cfg.minorsEnabled == true && text(cfg.minorApprovalReference,200) && text(cfg.minorProcedure,2000)
        && text(cfg.minorAssentVersion,100) && text(cfg.guardianConsentVersion,100)
        && c.assent == true && c.assentVersion == cfg.minorAssentVersion && c.guardianConsentVersion == cfg.guardianConsentVersion
        && grant.approved == true && grant.approvalReference == cfg.minorApprovalReference
        && grant.assentVersion == cfg.minorAssentVersion && grant.guardianConsentVersion == cfg.guardianConsentVersion
        && grant.expiresAt is timestamp && grant.expiresAt > request.time;
    }
    function consent(c, age, uid, cfg) {
      return fields(c,['read','voluntary','version','timestamp','assent','assentVersion','guardianConsentVersion'])
        && c.read == true && c.voluntary == true && c.version == cfg.consentVersion && c.timestamp == request.time
        && (age < 18 ? minorApproved(uid,c,cfg) : (c.assent == false && c.assentVersion == '' && c.guardianConsentVersion == ''));
    }
    function validSubmission(d, uid) {
      let cfg = policy();
      return cfg.collectionEnabled == true && text(cfg.institution,200) && text(cfg.contactEmail,200)
        && text(cfg.retention,500) && text(cfg.withdrawal,1000) && text(cfg.ethicsStatus,500) && text(cfg.consentVersion,100)
        && (d.schemaVersion == 2 ? fields(d,['responseId','ownerUid','consent','profile','dayRepresentativeness','dayType','catalogVersion','schemaVersion','createdAt','accurate'])
          : (d.schemaVersion == 3 && fields(d,['responseId','ownerUid','consent','profile','dayRepresentativeness','dayType','catalogVersion','schemaVersion','createdAt','accurate','mealOrder']) && validMealOrder(d.mealOrder)))
        && d.responseId == uid && d.ownerUid == uid && d.createdAt == request.time && d.accurate == true
        && d.catalogVersion == cfg.catalogVersion && profile(d.profile) && consent(d.consent,d.profile.age,uid,cfg)
        && d.dayRepresentativeness in ['Very typical','Mostly typical','Somewhat typical','Unusual']
        && d.dayType in ['Typical weekday','Typical weekend','Both are similar'];
    }
    function validMealOrder(ids) {
      return ids is list && ids.size() >= 1 && ids.size() <= 8 && ids.toSet().size() == ids.size()
        && ids.hasOnly(['breakfast','lunch','snacks','dinner','extra1','extra2','extra3','extra4']);
    }
    function mealCreated(uid, name) { return getAfter(/databases/$(database)/documents/submissions/$(uid)/meals/$(name)).data.createdAt == request.time; }
    function orderedMealCreated(uid, ids, index) { return ids.size() <= index || mealCreated(uid,ids[index]); }
    function completeMeals(uid) {
      let d = getAfter(/databases/$(database)/documents/submissions/$(uid)).data;
      // Receipt validation shares the atomic completeness checks, keeping each
      // operation below Firestore's 10-document access limit, even for minors.
      return d.schemaVersion == 2 || (validMealOrder(d.mealOrder)
        && orderedMealCreated(uid,d.mealOrder,0) && orderedMealCreated(uid,d.mealOrder,1)
        && orderedMealCreated(uid,d.mealOrder,2) && orderedMealCreated(uid,d.mealOrder,3)
        && orderedMealCreated(uid,d.mealOrder,4) && orderedMealCreated(uid,d.mealOrder,5)
        && orderedMealCreated(uid,d.mealOrder,6) && orderedMealCreated(uid,d.mealOrder,7));
    }
    match /study/config { allow get: if true; allow list, write: if false; }
    match /minorEligibility/{uid} { allow get: if own(uid); allow list, write: if false; }
    match /submissions/{uid} {
      allow create: if own(uid) && validSubmission(request.resource.data, uid)
        && (request.resource.data.schemaVersion == 3 || (mealCreated(uid,'breakfast') && mealCreated(uid,'lunch') && mealCreated(uid,'snacks') && mealCreated(uid,'dinner')))
        && getAfter(/databases/$(database)/documents/receipts/$(uid)).data.responseId == uid
        && getAfter(/databases/$(database)/documents/receipts/$(uid)).data.createdAt == request.time;
      allow read, update, delete: if false;
      match /meals/{name} {
        allow create: if own(uid)
          && !exists(/databases/$(database)/documents/submissions/$(uid))
          && getAfter(/databases/$(database)/documents/submissions/$(uid)).data.createdAt == request.time
          && (getAfter(/databases/$(database)/documents/submissions/$(uid)).data.schemaVersion == 3
            ? name in getAfter(/databases/$(database)/documents/submissions/$(uid)).data.mealOrder
            : name in ['breakfast','lunch','snacks','dinner'])
          && meal(request.resource.data,getAfter(/databases/$(database)/documents/submissions/$(uid)).data.schemaVersion);
        allow read, update, delete: if false;
      }
    }
    match /receipts/{uid} {
      allow get: if own(uid);
      allow create: if own(uid) && fields(request.resource.data,['responseId','createdAt'])
        && request.resource.data.responseId == uid && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/submissions/$(uid))
        && getAfter(/databases/$(database)/documents/submissions/$(uid)).data.ownerUid == uid
        && completeMeals(uid);
      allow list, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
